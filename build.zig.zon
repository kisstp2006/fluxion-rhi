.{
    .name = .fluxion_rhi,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x4163e3da0ff09bfa,
    .dependencies = .{
        // The three backends, and what they are written against.
        .fluxion_gl = .{
            .url = "git+https://github.com/kisstp2006/fluxion-gl#e0306318927fe3a01da076c35feee3114b2df431",
            .hash = "fluxion_gl-0.1.0-F9AI4gBqBQAT4U-RIbTAoMEOWFf3ue0U-i1ov5lQhc80",
        },
        .fluxion_d3d = .{
            .url = "git+https://github.com/kisstp2006/fluxion-d3d#c23780c7631155959f02c7a90151aa06ede818c7",
            .hash = "fluxion_d3d-0.1.0-ufazEIAiBQBXIwpGjiKPgUvn2CNbuSK7znQRtX_rIanO",
        },
        // The Vulkan loader and generated ABI. The RHI opens it at run time,
        // just as the Direct3D backend opens its system DLLs. Pinned to the
        // commit with `src/gen/` (every generated struct/command past the
        // loader's own door) pushed.
        .fluxion_vulkan = .{
            .url = "git+https://github.com/kisstp2006/fluxion-vulkan#7bec633080135d3891a15a53f3467058bd1b2b7e",
            .hash = "fluxion_vulkan-0.1.0-8VC-cTC0EwBjdBAPtcHQiPoCbsJSPmfWRKr24UFq4U9Y",
        },
        // Not lazy, though only a browser draws with it: off wasm it is the
        // stub the WebGL backend's tests run against, and it has no
        // dependencies of its own to fetch. Pinned to a commit that has the
        // calls the backend binds by slot with, and that names its glue.
        .fluxion_webgl = .{
            .url = "git+https://github.com/kisstp2006/fluxion-webgl#96e2dbd476d5c885305ce5f9ecdc5c7f5c40da77",
            .hash = "fluxion_webgl-0.1.0-8yvbdRt_AwAiIjGJGYHGq2unm_WrevHDQ6nEfEeUP09e",
        },
        // `Clip`: which clip space a device wants, so a projection is built
        // for the backend that was actually opened.
        .fluxion_math = .{
            .url = "git+https://github.com/kisstp2006/fluxion-math#1868bdb33577c9653d355f59ddd7ea1177b0cfaa",
            .hash = "fluxion_math-0.1.0-dfpZBX_OGQDOAYcHTfGTFzjg8z8S6olSgZrJvIXVeW2f",
        },
        // Generational handles: what a program holds instead of a pointer
        // into a backend.
        .fluxion_id = .{
            .url = "git+https://github.com/kisstp2006/fluxion-id#e3edea27d6f400116a95c0a80c08db9e4d134f12",
            .hash = "fluxion_id-0.1.0--9Hv-iARBQBEDRul1NUEj0YIkC26XNewehht9xldmQsK",
        },

        // What the examples draw into and save with. Lazy: fetched only when
        // the examples are built, which is when this is the root package or
        // `-Dexamples` is given. The library never opens a window and never
        // writes a file.
        .fluxion_platform = .{
            .url = "git+https://github.com/kisstp2006/fluxion-platform#34bf721edc2920c7dcee82fa3f0d832ea2408f08",
            .hash = "fluxion_platform-0.1.0-WsOjUU_5GgBCl8D_Rx1doGGZ2oSla-aC0Y21jX9Q7pTs",
            .lazy = true,
        },
        .fluxion_image = .{
            .url = "git+https://github.com/kisstp2006/fluxion-image#9d017f7f82556b6f587121f3255f7ff0a5ec3e55",
            .hash = "fluxion_image-0.1.0-fyJkdX63AgASTcyVbd034C0ZTGGM-0kDT_IGQuBilnF0",
            .lazy = true,
        },
        // What the sprite example writes its shader in - once, rather than
        // once per backend. Lazy for the same reason as the rest: this
        // library takes shader source as text and does not care where the
        // text came from.
        //
        .fluxion_shader = .{
            .url = "git+https://github.com/kisstp2006/fluxion-shader#7ca72477aaf61fe075e8c8ec487fdc1a07c83754",
            .hash = "fluxion_shader-0.1.0-FqFMEv6YCAAkCt9CuC5fnmNVHpr25rvSIVf7EX__Ha3s",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "README.md",
        "LICENSE",
    },
}
