.{
    .name = .fluxion_rhi,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x4163e3da0ff09bfa,
    .dependencies = .{
        // The three backends, and what they are written against.
        .fluxion_gl = .{
            .url = "git+https://github.com/kisstp2006/fluxion-gl#d4887d3ca907b71fe5eda2537b8d0a7e929ee9e5",
            .hash = "fluxion_gl-0.1.0-F9AI4lllBQDMizdNIdX6Qff0Yzip8x_2vu-mh5kebWkw",
        },
        .fluxion_d3d = .{
            .url = "git+https://github.com/kisstp2006/fluxion-d3d#161140d820bbec900735dff877dda80133f4e295",
            .hash = "fluxion_d3d-0.1.0-ufazEIAiBQB4FZp7I3O4DAQibxpepr8RtGa2ntS9wmen",
        },
        // The Vulkan loader and generated ABI. The RHI opens it at run time,
        // just as the Direct3D backend opens its system DLLs. Pinned to the
        // commit with `src/gen/` (every generated struct/command past the
        // loader's own door) pushed.
        .fluxion_vulkan = .{
            .url = "git+https://github.com/kisstp2006/fluxion-vulkan#7bec633080135d3891a15a53f3467058bd1b2b7e",
            .hash = "fluxion_vulkan-0.1.0-8VC-cTC0EwBjdBAPtcHQiPoCbsJSPmfWRKr24UFq4U9Y",
        },
        // Not lazy, though only a browser draws with it: off wasm it is the
        // stub the WebGL backend's tests run against, and it has no
        // dependencies of its own to fetch. Pinned to a commit that has the
        // calls the backend binds by slot with, and that names its glue.
        .fluxion_webgl = .{
            .url = "git+https://github.com/kisstp2006/fluxion-webgl#228b85f17702d28660e3fa6745ad7fcb3faa32ee",
            .hash = "fluxion_webgl-0.1.0-8yvbdRdVAwDPfmGZBp5vku1-TRr6fCwl5ka84zXvguxU",
        },
        // `Clip`: which clip space a device wants, so a projection is built
        // for the backend that was actually opened.
        .fluxion_math = .{
            .url = "git+https://github.com/kisstp2006/fluxion-math#92afdbddbf930369265d24136402c7eb5dd8f70e",
            .hash = "fluxion_math-0.1.0-dfpZBeNUBAAwUMriLKaOTRBWGFmfY53_jyYuMUxkPYek",
        },
        // Generational handles: what a program holds instead of a pointer
        // into a backend.
        .fluxion_id = .{
            .url = "git+https://github.com/kisstp2006/fluxion-id#a52c29dfe5ac0a49a5d5469cdc1a4fb96b799ccc",
            .hash = "fluxion_id-0.1.0--9Hv-nGFAQAW36SvJvMB6L1nUNErZzh7JC0-nRPlrotw",
        },

        // What the examples draw into and save with. Lazy: fetched only when
        // the examples are built, which is when this is the root package or
        // `-Dexamples` is given. The library never opens a window and never
        // writes a file.
        .fluxion_platform = .{
            .url = "git+https://github.com/kisstp2006/fluxion-platform#5b9e0f68299117b924849a71452c31a5edc6d0dc",
            .hash = "fluxion_platform-0.1.0-WsOjUbdyGAC9gDHrhCOkb_LcsXrOzijfatykISXtqLaa",
            .lazy = true,
        },
        .fluxion_image = .{
            .url = "git+https://github.com/kisstp2006/fluxion-image#79463ef201f11e15ada014467c0ad1d58b2a882d",
            .hash = "fluxion_image-0.1.0-fyJkdS7vAAB1p43VSutvpxQB32hIcvJb3fGSZbo_qeha",
            .lazy = true,
        },
        // What the sprite example writes its shader in - once, rather than
        // once per backend. Lazy for the same reason as the rest: this
        // library takes shader source as text and does not care where the
        // text came from.
        //
        .fluxion_shader = .{
            .url = "git+https://github.com/kisstp2006/fluxion-shader#ae10e60674941a1a6cc1798f3259789a69ac4746",
            .hash = "fluxion_shader-0.1.0-FqFMEmBUBwAgRXrR34cXH0CUDdTUDtZ-EMPuSKS9ZfIF",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "README.md",
    },
}
