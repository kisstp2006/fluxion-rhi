.{
    .name = .fluxion_rhi,
    .version = "0.2.1",
    .minimum_zig_version = "0.17.0",
    .fingerprint = 0x4163e3da0ff09bfa,
    .dependencies = .{
        // The three backends, and what they are written against.
        .fluxion_gl = .{
            .url = "git+https://github.com/kisstp2006/fluxion-gl#2852c4abf1c94ddfad6b7308fbca1d38962c6cbb",
            .hash = "fluxion_gl-0.2.0-F9AI4u8EAwADJqV9rhyj-u7RcDjgrZRKUbfY4wGE8ZsY",
        },
        .fluxion_d3d = .{
            .url = "git+https://github.com/kisstp2006/fluxion-d3d#6b295a592e88caba6839ae5975392185264f05d0",
            .hash = "fluxion_d3d-0.2.0-ufazEKI9AwAFxv52MeMVlFrVNI_Jr1QJjyZ88MAHPqQ2",
        },
        // The Vulkan loader and generated ABI. The RHI opens it at run time,
        // just as the Direct3D backend opens its system DLLs. Pinned to the
        // commit with `src/gen/` (every generated struct/command past the
        // loader's own door) pushed.
        .fluxion_vulkan = .{
            .url = "git+https://github.com/kisstp2006/fluxion-vulkan#6e127af4a91d96047c09f5160b1f07a21d3a931d",
            .hash = "fluxion_vulkan-0.2.0-8VC-cScNFADr__doQK9L4B0XqnaqMnK0lUiH7AFYU3yN",
        },
        // Not lazy, though only a browser draws with it: off wasm it is the
        // stub the WebGL backend's tests run against, and it has no
        // dependencies of its own to fetch. Pinned to a commit that has the
        // calls the backend binds by slot with, and that names its glue.
        .fluxion_webgl = .{
            .url = "git+https://github.com/kisstp2006/fluxion-webgl#185d581638e778924dbd87dbcebc397293ee200b",
            .hash = "fluxion_webgl-0.2.1-8yvbdSIMAwBn5ao8EmOkTErpxV483UvxaXFHoCfYsKTw",
        },
        // `Clip`: which clip space a device wants, so a projection is built
        // for the backend that was actually opened.
        .fluxion_math = .{
            .url = "git+https://github.com/kisstp2006/fluxion-math#f293d43436e9c8f8fb2fb656732792597cf5ddfe",
            .hash = "fluxion_math-0.3.0-dfpZBcFUBAC-eB5TEpCW-PdkIUGEurBEI8cTvyvbFc_r",
        },
        // Generational handles: what a program holds instead of a pointer
        // into a backend.
        .fluxion_id = .{
            .url = "git+https://github.com/kisstp2006/fluxion-id#5a45bef918dbc0149e2f4e7759eb2a5cdf335264",
            .hash = "fluxion_id-0.2.1--9Hv-rMUBQBd1AAinOPMg9zvCuy4edjE0JzrzEthmJMG",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "README.md",
        "LICENSE",
    },
}
